<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Add a new Flat</h1>

      <%= form_with model: @flat, local: true, class: "card p-4 shadow-sm" do |f| %>
        <div class="mb-3">
          <%= f.label :name, class: "form-label fw-bold" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :address, class: "form-label fw-bold" %>
          <%= f.text_field :address, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :description, class: "form-label fw-bold" %>
          <%= f.text_area :description, class: "form-control", rows: 3 %>
        </div>

        <div class="mb-3">
          <%= f.label :number_of_guests, "Number of guests", class: "form-label fw-bold" %>
          <%= f.number_field :number_of_guests, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= f.label :price_per_night, "Price per night (€)", class: "form-label fw-bold" %>
          <%= f.number_field :price_per_night, class: "form-control" %>
        </div>

        <div class="d-flex justify-content-between">
          <%= f.submit "Create Flat", class: "btn btn-primary" %>
          <%= link_to "Cancel", flats_path, class: "btn btn-danger" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
