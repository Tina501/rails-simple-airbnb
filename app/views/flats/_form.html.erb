<div class="container mt-5">
  <div class="card shadow-lg p-4">
    <h2 class="text-center mb-4"><%= @flat.persisted? ? "Edit Flat" : "Add a New Flat" %></h2>
    <%= form_with(model: @flat, local: true) do |form| %>
      <div class="form-group mb-3">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control", placeholder: "Flat Name" %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :address, class: "form-label" %>
        <%= form.text_field :address, class: "form-control", placeholder: "Address" %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", placeholder: "Description", rows: 3 %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :number_of_guests, class: "form-label" %>
        <%= form.number_field :number_of_guests, class: "form-control", min: 1 %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :price_per_night, class: "form-label" %>
        <%= form.number_field :price_per_night, class: "form-control", step: 1 %>
      </div>

      <div class="form-group mb-3">
        <%= form.label :picture_url, class: "form-label" %>
        <%= form.text_field :picture_url, class: "form-control", placeholder: "Image URL" %>
      </div>

      <div class="d-flex justify-content-between">
        <%= form.submit @flat.persisted? ? "Update Flat" : "Create Flat", class: "btn btn-primary" %>
        <%= link_to "Cancel", flats_path, class: "btn btn-danger" %>
      </div>
    <% end %>
  </div>
</div>
