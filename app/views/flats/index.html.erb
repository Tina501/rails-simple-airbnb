<div class="container mt-5">
  <h1 class="mb-4">All our Flats (<%= @flats.count %>)</h1>

  <div class="row">
    <% @flats.each do |flat| %>
      <div class="col-md-4">
        <div class="card shadow-sm mb-4">
          <img src="<%= flat.picture_url %>" class="card-img-top" alt="Flat image">
          <div class="card-body">
            <h5 class="card-title"><%= flat.name %></h5>
            <p class="card-text text-muted"><%= flat.address %></p>
            <p><strong>💰 €<%= flat.price_per_night %></strong> per night</p>
            <p>👤 <%= flat.number_of_guests %> guests</p>
            <div class="d-flex justify-content-between">
              <%= link_to "More info", flat_path(flat), class: "btn btn-primary" %>
              <%= link_to "Edit", edit_flat_path(flat), class: "btn btn-warning" %>
              <%= link_to "Delete", flat_path(flat),
              data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "btn btn-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>


</div>
